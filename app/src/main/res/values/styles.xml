<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="ThemeOverlay.ShopLiNote.SettingsPreferences" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/theme_muted_text</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.ShopLiNote.SettingsDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/dialog_card_background</item>
        <item name="android:windowElevation">8dp</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/theme_muted_text</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
    </style>

    <style name="PreferenceSummaryTextStyle" tools:override="true">
        <item name="android:textColor">?attr/theme_muted_text</item>
    </style>

    <style name="ThemeOverlay.ShopLiNote.LavenderDreamActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="colorControlNormal">@android:color/white</item>
    </style>

    <style name="Widget.ShopLiNote.GradientActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@drawable/theme_gradient</item>
        <item name="android:background">@drawable/theme_gradient</item>
        <item name="titleTextStyle">@style/TextAppearance.ShopLiNote.ActionBarTitle</item>
    </style>

    <style name="Widget.ShopLiNote.GradientActionBar.LavenderDream" parent="Widget.ShopLiNote.GradientActionBar">
        <item name="homeAsUpIndicator">@drawable/ic_back_lavender</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_back_lavender</item>
        <item name="titleTextStyle">@style/TextAppearance.ShopLiNote.LavenderDreamActionBarTitle</item>
        <item name="android:titleTextStyle">@style/TextAppearance.ShopLiNote.LavenderDreamActionBarTitle</item>
    </style>

    <style name="TextAppearance.ShopLiNote.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">?attr/theme_on_gradient</item>
    </style>

    <style name="TextAppearance.ShopLiNote.LavenderDreamActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.ShopLiNote.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/theme_btn</item>
        <item name="android:textColor">?attr/theme_btn_text</item>
    </style>
</resources>
