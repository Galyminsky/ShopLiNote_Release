<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:layout="@layout/ds_preference_category"
        android:title="@string/ds_settings_general">
        <ListPreference
            android:defaultValue="Linear"
            android:entries="@array/note_style_array"
            android:entryValues="@array/note_style_values"
            android:key="note_style_key"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item"
            android:icon="@drawable/ds_ic_panels_top_left"
            android:title="@string/chose_note_style" />
        <ListPreference
            android:defaultValue="HH:mm:ss - dd.MM.yyyy"
            android:entries="@array/time_format_array"
            android:entryValues="@array/time_format_values"
            android:key="time_format_key"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item"
            android:icon="@drawable/ds_ic_calendar_days"
            android:title="@string/chose_time_format" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/ds_preference_category"
        android:title="@string/theme_settings">
        <ListPreference
            android:defaultValue="light"
            android:entries="@array/ds_mode_labels"
            android:entryValues="@array/ds_mode_values"
            android:key="ds_mode"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item"
            android:icon="@drawable/ds_ic_moon"
            android:title="@string/chose_theme" />
    </PreferenceCategory>


    <PreferenceCategory
        android:layout="@layout/ds_preference_category"
        android:title="@string/note_text_setting">
        <ListPreference
            android:defaultValue="20"
            android:entries="@array/text_size_array"
            android:entryValues="@array/text_size_values"
            android:key="title_size_key"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item"
            android:icon="@drawable/ds_ic_notebook_pen"
            android:title="@string/title_text_size" />
        <ListPreference
            android:defaultValue="16"
            android:entries="@array/text_size_array"
            android:entryValues="@array/text_size_values"
            android:key="content_size_key"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item"
            android:icon="@drawable/ds_ic_pencil"
            android:title="@string/content_text_size" />
    </PreferenceCategory>

</PreferenceScreen>
