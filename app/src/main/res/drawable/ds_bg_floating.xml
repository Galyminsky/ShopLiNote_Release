<?xml version="1.0" encoding="utf-8"?>
<!-- Floating background: surface for overlays such as popups and dialogs. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface_floating" />
    <stroke
        android:width="1dp"
        android:color="@color/ds_stroke_floating" />
    <corners android:radius="14dp" />
</shape>
