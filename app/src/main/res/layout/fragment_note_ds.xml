<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:orientation="vertical">

    <include
        layout="@layout/notes_header_ds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_screen_padding_h"
        android:layout_marginTop="@dimen/ds_screen_padding_top" />

    <include
        layout="@layout/section_header_ds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ds_screen_padding_h"
        android:layout_marginTop="@dimen/ds_space_block"
        android:layout_marginBottom="@dimen/ds_space_list" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcViewNote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/ds_screen_padding_h"
        android:paddingBottom="24dp"
        tools:itemCount="3"
        tools:listitem="@layout/note_list_item_ds" />
</LinearLayout>
