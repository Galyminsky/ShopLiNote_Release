<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/ds_screen_padding_h"
    android:paddingTop="@dimen/ds_screen_padding_top"
    android:paddingBottom="@dimen/ds_screen_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_note_edit_toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" app:srcCompat="@drawable/ds_ic_chevron_left" app:tint="@color/ds_note_color_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:fontFamily="@font/inter_regular" android:text="@string/note_edit_cancel" android:textColor="@color/ds_note_color_ink" android:textSize="14sp" />
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="@dimen/ds_note_edit_save_width"
            android:layout_height="@dimen/ds_note_edit_save_height"
            android:background="@drawable/ds_bg_note_edit_save"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/note_edit_save"
            android:textColor="@color/ds_on_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEditScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_block"
        android:text="@string/note_edit_new_title"
        android:textAppearance="@style/TextAppearance.DS.NoteEditScreenTitle"
        tools:text="@string/note_edit_edit_title" />
    <TextView
        android:id="@+id/tvEditDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/note_edit_date_preview"
        android:textAppearance="@style/TextAppearance.DS.NoteEditDate"
        tools:text="30 октября 2026 · 09:41" />

    <com.jobforandroid.shoplinoterelease.ui.ds.NeumorphicSurface
        android:id="@+id/cardEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ds_space_block"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="@dimen/ds_note_edit_card_padding"
        app:dsCornerRadius="@dimen/ds_radius_m"
        app:dsVariant="inset">
        <ScrollView
            android:id="@+id/svEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvFieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/note_edit_field_title" android:textAppearance="@style/TextAppearance.DS.NoteEditLabel" />
                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/note_edit_title_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:padding="0dp"
                    android:textAppearance="@style/TextAppearance.DS.NoteEditTitleInput"
                    tools:text="@string/note_edit_preview_title" />
                <View android:id="@+id/vDivider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="@color/ds_divider" />
                <EditText
                    android:id="@+id/etContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/note_edit_content_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="8"
                    android:padding="0dp"
                    android:textAppearance="@style/TextAppearance.DS.NoteEditContentInput"
                    tools:text="@string/note_edit_preview_content" />
            </LinearLayout>
        </ScrollView>
    </com.jobforandroid.shoplinoterelease.ui.ds.NeumorphicSurface>

    <com.jobforandroid.shoplinoterelease.ui.ds.NeumorphicSurface
        android:id="@+id/panelFormat"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_note_edit_format_height"
        android:layout_marginHorizontal="@dimen/ds_note_edit_format_shadow_margin"
        android:layout_marginTop="@dimen/ds_space_block"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        app:dsCornerRadius="@dimen/ds_radius_m"
        app:dsVariant="raisedFlat">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:id="@+id/btnBold" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="@string/note_edit_format_bold" android:focusable="true">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" app:srcCompat="@drawable/ds_ic_bold" app:tint="@color/ds_note_color_ink" />
            </FrameLayout>
            <FrameLayout android:id="@+id/btnItalic" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="@string/note_edit_format_italic" android:focusable="true">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" app:srcCompat="@drawable/ds_ic_italic" app:tint="@color/ds_note_color_ink" />
            </FrameLayout>
            <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/ds_divider" />
            <LinearLayout android:id="@+id/btnColor" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="@string/note_edit_format_color" android:focusable="true" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/tvColorGlyph" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/inter_medium" android:text="A" android:textColor="@color/ds_note_color_accent" android:textSize="20sp" />
                <View android:id="@+id/vColorBar" android:layout_width="17dp" android:layout_height="3dp" android:layout_marginTop="3dp" android:background="@drawable/ds_bg_note_color_bar" />
            </LinearLayout>
        </LinearLayout>
    </com.jobforandroid.shoplinoterelease.ui.ds.NeumorphicSurface>

    <TextView
        android:id="@+id/tvEditStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_regular"
        android:lineHeight="15.4dp"
        android:textColor="@color/ds_on_surface_variant"
        android:textSize="11sp"
        android:visibility="invisible"
        tools:text="@string/note_edit_status_draft" />
</LinearLayout>
